import sys
import time
import shutil

def escrever(texto, velocidade):
    largura = shutil.get_terminal_size().columns
    texto = texto.center(largura)

    for letra in texto:
        sys.stdout.write(letra)
        sys.stdout.flush()
        time.sleep(velocidade)
    print()

def desenhar():
    largura = shutil.get_terminal_size().columns

    desenho = [
        "~•~•~•~•~•"
    ]

    for linha in desenho:
        print(linha.center(largura))
        time.sleep(0.1)

desenhar()

